{
  "name": "image-detector-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx serverless@3 deploy && npm run upload",
    "upload": "aws s3 sync dist s3://image-detector-frontend-dev --delete",
    "remove": "npx serverless@3 remove",
    "info": "npx serverless@3 info"
  },
  "dependencies": {
    "antd": "^5.12.8",
    "axios": "^1.6.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^5.0.11",
    "serverless": "^3.38.0"
  }
}
